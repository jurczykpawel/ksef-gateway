meta {
  name: Health check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}

tests {
  test("Only liveness status is public", function () {
    expect(res.getBody()).to.deep.equal({ status: "ok" });
  });
}
