<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests call AddOpenApi()/MapOpenApi() themselves; the OpenAPI source generator needs this namespace enabled. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK dependencies: patched CMS/XML signature implementations (October 2026). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KSeFGateway.Api\KSeFGateway.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Discovery/sdk-contract.approved.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Schemas\**\*.xsd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
