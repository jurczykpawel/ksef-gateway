<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- CIRFMF Official KSeF SDK (GitHub Packages) -->
    <PackageReference Include="KSeF.Client" Version="2.10.0" />
    <PackageReference Include="KSeF.Client.ClientFactory" Version="2.10.0" />

    <!-- OpenAPI (built-in on .NET 10) -->
    <!-- 11.x on .NET 11; the AWS Lambda image builds with -p:TargetFramework=net10.0 (no .NET 11
         Lambda base image yet), which needs the 10.x package. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.0.1" />

    <!-- AWS Lambda hosting (no-op when not running on Lambda) -->
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
  </ItemGroup>

</Project>
