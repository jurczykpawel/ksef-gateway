<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- CIRFMF Official KSeF SDK (GitHub Packages) -->
    <PackageReference Include="KSeF.Client" Version="2.9.0" />
    <PackageReference Include="KSeF.Client.ClientFactory" Version="2.9.0" />

    <!-- OpenAPI (built-in on .NET 10) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />

    <!-- AWS Lambda hosting (no-op when not running on Lambda) -->
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.10.0" />
  </ItemGroup>

</Project>
