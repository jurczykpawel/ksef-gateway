<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK dependencies: patched CMS/XML signature implementations (October 2026). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="KSeF.Client" Version="2.9.0" />
    <PackageReference Include="KSeF.Client.ClientFactory" Version="2.9.0" />
  </ItemGroup>

</Project>
